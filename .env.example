# Public Supabase configuration (use one public key name, not both)
NEXT_PUBLIC_SUPABASE_URL=
# Current Supabase projects use a publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects can use an anon key instead of the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase access — never expose this as NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3010
NEXT_PUBLIC_WATERCANVAS_ENABLED=false
NEXT_PUBLIC_AMBIENT_AUDIO_ENABLED=false
# The archived WebGL and ambient-audio experiments remain opt-in and are not
# mounted by the current Ink on Water production layout.
# The full listening room is active by default.
NEXT_PUBLIC_INLINE_TURNTABLE_ENABLED=true
# The legacy floating companion stays off unless explicitly restored.
NEXT_PUBLIC_TURNTABLE_ENABLED=false

# Phase 2+ server-only integrations
# Checkout remains disabled unless this is explicitly changed after the
# inventory/order migration gates pass.
COMMERCE_MODE=off
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional observability and social integrations
META_APP_ID=
TWITTER_BEARER_TOKEN=
SENTRY_DSN=
